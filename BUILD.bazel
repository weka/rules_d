load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

package_metadata(
    name = "package_metadata",
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

bool_flag(
    name = "enable_header_generation",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Exact deps: a D compile's action key holds only the imported D sources the compile read (-makedeps),
# so editing one it did not read does not re-run it. Bazel honours this in its local action cache, not
# in remote cache keys. Needs GNU coreutils (realpath -e, xargs -d) where the compile runs.
bool_flag(
    name = "exact_deps",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# A D compile writes the list of dependency files it did not read, and bazel does not prune with it.
# The compile action is then the one exact_deps declares, so a build that must not prune (CI, a
# release) and a build with exact_deps share remote cache entries. With exact_deps on, this flag
# changes nothing. Needs the same GNU coreutils as exact_deps.
bool_flag(
    name = "record_unread_deps",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)
