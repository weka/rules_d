load("@rules_d//d:defs.bzl", "d_library", "d_test")

package(default_visibility = ["//visibility:public"])

# Test 1: Library with separate interface file
# Compiles implementation but only exposes .di interface to consumers
d_library(
    name = "separate_interface_lib",
    srcs = ["hdrs_only_impl.d"],
    hdrs = ["hdrs_only_lib.di"],
)

d_test(
    name = "separate_interface_test",
    srcs = ["hdrs_only_test.d"],
    deps = [":separate_interface_lib"],
)

# Test 2: True headers-only library (no compilation)
# Provides interface with no sources - implementation comes from dependency
d_library(
    name = "pure_interface_impl",
    srcs = ["pure_interface_impl.d"],
)

d_library(
    name = "pure_interface_lib",
    hdrs = ["pure_interface.di"],
    deps = [":pure_interface_impl"],
)

d_test(
    name = "pure_interface_test",
    srcs = ["pure_interface_test.d"],
    deps = [":pure_interface_lib"],
)

# Test 3: Library with exports attribute
d_library(
    name = "partial_export_lib",
    srcs = [
        "internal.d",
        "public_api.d",
    ],
    exports = ["public_api.d"],
)

d_test(
    name = "partial_export_test",
    srcs = ["partial_export_test.d"],
    deps = [":partial_export_lib"],
)

# Test 3: Library without hdrs/exports (backward compatibility)
d_library(
    name = "legacy_lib",
    srcs = ["legacy.d"],
)

d_test(
    name = "legacy_test",
    srcs = ["legacy_test.d"],
    deps = [":legacy_lib"],
)
