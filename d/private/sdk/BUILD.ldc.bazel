load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_d//d:config.bzl", "d_toolchain_config")
load("@rules_d//d:toolchain.bzl", "d_toolchain")

filegroup(
    name = "all_files",
    srcs = [
        ":dmd",
        ":dub",
        ":rdmd",
    ],
)

filegroup(
    name = "druntime_files",
    srcs = glob([
        "import/core/**",
        "import/etc/**",
    ]) + ["import/object.d"],
)

filegroup(
    name = "phobos_files",
    srcs = glob(["import/std/**"]),
)

filegroup(
    name = "stdlib_files",
    srcs = glob(["lib/**"]),
)

cc_import(
    name = "druntime",
    static_library = "lib/libdruntime-ldc.a",
)

cc_import(
    name = "libphobos",
    static_library = "lib/libphobos2-ldc.a",
)

filegroup(
    name = "dmd",
    srcs = ["bin/ldc2"],
    data = [
        ":druntime_files",
        ":phobos_files",
        ":stdlib_files",
    ],
)

filegroup(
    name = "dub",
    srcs = ["bin/dub"],
)

filegroup(
    name = "rdmd",
    srcs = ["bin/rdmd"],
    data = [":dmd"],
)

d_toolchain_config(
    name = "ldc_config",
    d_compiler = ":dmd",
    druntime = ":druntime",
    dub_tool = ":dub",
    libphobos = ":libphobos",
    linker_flags = [],
    rdmd_tool = ":rdmd",
    # LDC-specific flags (using ldc2 directly)
    compiler_flags = [
        "-w",  # Enable warnings
        "--relocation-model=pic"
    ],
    codegen_opts_common = ["--relocation-model=pic"],
    compiler_flags_dbg = ["-g", "-d-debug", "-d-version=debug_assert"],
    compiler_flags_opt = ["-O3", "-release"],
    lib_flags = ["-lib"],
    single_obj_flag = "--singleobj",
    import_flags = ["-I"],
    version_flag = "-d-version=",
    # LDC supports bitcode with LTO
    output_bc_flags = ["-flto=full"],
    qualified_object_file_names = False,
    single_object = True,
    compile_via_bc = False,
    fat_lto = False,
)

d_toolchain(
    name = "d_toolchain",
    config = ":ldc_config",
)
